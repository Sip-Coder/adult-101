# Copy to .env.local. Leave the Supabase values blank and the site still runs:
# lessons stay readable, and the sign-in buttons show "Not configured yet".

# Project Settings → API → Project URL
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Preferred: the publishable key from Project Settings → API.
# Never put the service_role or secret key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy name. Used only when the publishable key above is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used when a sign-in request has no Origin header. Local default is fine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local demo learner (progress stored in a cookie on this browser).
# true  — always offer the demo learner, even when Supabase is configured
# false — hide the demo learner
# unset — offer it only when Supabase keys are missing
NEXT_PUBLIC_DEMO_MODE=
